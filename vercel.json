{
  "redirects": [
    {
      "source": "/episodes/opentofu",
      "destination": "/episodes/open-tofu/",
      "permanent": true
    },
    {
      "source": "/episodes/opentofu/",
      "destination": "/episodes/open-tofu/",
      "permanent": true
    },
    {
      "source": "/get/opentofu",
      "destination": "/get/open-tofu",
      "permanent": true
    },
    {
      "source": "/get/opentofu/",
      "destination": "/get/open-tofu",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.png|apple-touch-icon.png|og-default.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
